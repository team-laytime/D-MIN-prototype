# 복사해서 .env로 쓰세요. .env는 저장소에 올리지 않습니다(NFR-13).
POSTGRES_PASSWORD=change-me-local-only
APP_PORT=8000
# LLM은 선택입니다. none이면 템플릿 문장으로 끝까지 동작합니다(NFR-10).
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_COST_CAP_USD=1.0
# 호스트의 ANTHROPIC_BASE_URL을 그대로 쓰지 않도록 주소를 따로 둡니다.
LLM_BASE_URL=https://api.anthropic.com
# 공공데이터포털 서비스키(Decoding 키). 한 개로 신청·승인된 API 전부에 쓴다. 값은 .env에만 두고 채팅·코드·커밋에 넣지 않는다.
# 쓰는 곳: 울산항 선박 위치(/api/ais/vessels), 입항·접안 기록(/api/ais/voyage), 입항 신고 ETA(/api/entry/arrivals), 일출·일몰.
# 없으면 선박 실시간 기능은 503을 돌려주고 나머지는 오프라인 계산본·시나리오 값으로 동작한다.
PUBLIC_DATA_SERVICE_KEY=
