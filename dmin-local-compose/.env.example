# 복사해서 .env로 쓴다(.env는 커밋하지 않는다). compose.yaml이 이 값을 Spring 컨테이너에만 넣는다.
# 공공데이터포털 Decoding 키 — 울산항 선박 위치(15156631)·운항정보(15156628)·입항 신고(15006353)에 같이 쓴다.
# 비워 두면 실시간 기능만 503으로 꺼지고, 데이터 넣기·후보 계산·재검증은 그대로 돈다.
PUBLIC_DATA_SERVICE_KEY=

# 호스트에 여는 포트 (127.0.0.1에만 연다). 지우거나 비워 두면 화면 18089 · Grafana 13000.
#DMIN_PORT=18089
#GRAFANA_PORT=13000
